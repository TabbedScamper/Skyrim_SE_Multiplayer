{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyrim-se-multiplayer.local/modsim/scenario-v1.schema.json",
  "title": "Skyrim SE Multiplayer ModSim scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "adapter", "seed", "participants", "actions", "assertions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "adapter": {
      "enum": [
        "protocol.join",
        "protocol.leader-handoff",
        "protocol.follower-reconnect",
        "protocol.quest-authority",
        "model.player-lifecycle",
        "pex.mq101-fragment"
      ]
    },
    "description": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "corpusHash": { "type": "string" },
    "productionBuild": { "type": "string" },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "role": { "enum": ["leader", "follower"] }
        }
      }
    },
    "initialState": { "type": "object" },
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDelayTicks": { "type": "integer", "minimum": 0 },
        "dropProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "duplicateProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowReorder": { "type": "boolean" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "actor", "type"],
        "properties": {
          "at": { "type": "integer", "minimum": 0 },
          "actor": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "after": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      }
    }
  }
}
